{
  "manifestVersion": 5,
  "id": "com.josueeguia.halftonedtf",
  "name": "Halftone DTF",
  "version": "0.6.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "halftoneDTF",
      "label": {
        "default": "Halftone DTF"
      },
      "minimumSize": {
        "width": 300,
        "height": 450
      },
      "maximumSize": {
        "width": 1600,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 760
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 760
      }
    }
  ]
}
