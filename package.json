{
  "name": "halftone-dtf-ps",
  "version": "0.6.4",
  "private": true,
  "description": "Panel UXP de semitonos con transparencia para Photoshop y DTF",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "package": "npm run build:ui && python3 scripts/package.py",
    "release:check": "node scripts/check-release.js",
    "distribution:prepare": "npm run build:ui && python3 scripts/prepare-distribution.py",
    "distribution:test": "python3 -m unittest discover -s tests -p 'distribution_test.py'",
    "build:ui": "node scripts/build-ui.mjs",
    "test:ui": "node tests/browser-ui.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@swc-uxp-wrappers/action-button": "2.0.0",
    "@swc-uxp-wrappers/button": "2.0.0",
    "@swc-uxp-wrappers/checkbox": "2.0.0",
    "@swc-uxp-wrappers/textfield": "2.0.0",
    "@swc-uxp-wrappers/utils": "2.0.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "138.0.2",
    "esbuild": "0.25.12",
    "playwright": "1.61.1"
  }
}
